QDRANT_URL=your_qdrant_cluster_url
QDRANT_API_KEY=your_qdrant_api_key

# Groq config (used when LLM_API_KEY is not set)
GROQ_API_KEY=your_groq_api_key

# OpenAI-compatible provider config (used when LLM_API_KEY is set)
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=your-base-url
# LLM_MODEL=your-llm-model

# ─── Numeric settings (all optional — defaults shown) ─────────────────────
# If set to an invalid value (non-integer, out of range), DevWhisper will
# print a ConfigError with the offending value, the expected type/range,
# and a concrete fix suggestion. See config.py for the full validation logic.

# Maximum file size in MB for indexing (default: 1). Files larger than this are skipped.
# Must be >= 1.
# MAX_FILE_SIZE_MB=1

# Number of lines per code chunk during indexing (default: 15). Must be >= 1
# and greater than INDEX_CHUNK_OVERLAP.
# INDEX_CHUNK_SIZE=15

# Number of overlapping lines between consecutive chunks (default: 3).
# Must be >= 0 and less than INDEX_CHUNK_SIZE.
# INDEX_CHUNK_OVERLAP=3

# Number of top results to return to the LLM after hybrid fusion (default: 6).
# Must be >= 1.
# RETRIEVAL_TOP_K=6

# Number of candidates retrieved per strategy before RRF fusion (default: 20).
# Must be >= 1.
# HYBRID_TOP_K=20

# Jaccard similarity threshold for near-duplicate query cache hits (default: 0.70).
# Must be between 0.0 and 1.0.
# CACHE_SIMILARITY_THRESHOLD=0.70

# Minimum cosine similarity score for Qdrant vector search results (default: 0.0).
# Must be between 0.0 and 1.0. Set to 0.0 to disable filtering.
# QDRANT_SIMILARITY_THRESHOLD=0.0

# Dimensionality of the embedding vectors (default: 384). Must match the model
# output and be >= 1.
# EMBEDDING_DIMENSIONS=384

# Admin secret for /admin/* debugging endpoints (e.g. /admin/sessions).
# If unset, admin endpoints fail closed (always 401). Generate a strong,
# random value for production (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
ADMIN_SECRET=change-me-to-a-long-random-secret

# ---------------------------------------------------------------------------
# Prompt budget
# ---------------------------------------------------------------------------
# Character ceiling for the retrieved code context in a single prompt. Nothing
# upstream bounds it: a chunk is INDEX_CHUNK_SIZE *lines* and a line has no
# length limit, so minified or generated files can produce chunks large enough
# to overrun any provider's context window. Truncation happens between result
# blocks, so the model never sees a half-written one.
MAX_PROMPT_CONTEXT_CHARS=48000

# Character ceiling for conversation history in a single prompt. Budgeted
# separately from code context, and deliberately smaller — a long earlier
# answer should not crowd out the code the current question is about. Set to 0
# to drop history from the prompt entirely.
MAX_PROMPT_HISTORY_CHARS=8000
